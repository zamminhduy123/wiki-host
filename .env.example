# ──────────────────────────────────────────────
#  Librarian Agent — Environment Configuration
# ──────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Secret token set in Telegram's setWebhook call for request validation
# TELEGRAM_SECRET_TOKEN=your_optional_secret_here

# Required for automatic webhook registration on startup:
# TELEGRAM_WEBHOOK_URL=https://your-public-domain.ngrok-free.dev/webhook/telegram

# GitHub Personal Access Token (needs repo read/write scope)
GITHUB_TOKEN=your_github_personal_access_token_here

# Target GitHub repository in "owner/repo" format
GITHUB_REPO=your_username/your_repo_name

# Branch to commit to (default: main)
GITHUB_BRANCH=main

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which provider to use: "gemini" (default) or "ollama"
# c

# Override the default model (Gemini defaults to gemini-1.5-pro-latest, Ollama to llama3)
# LLM_MODEL=gemini-1.5-pro-latest

# Base URL for Ollama (if using LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# ── Repo path prefixes ──
# Directory inside the repo that holds wiki markdown files
WIKI_DIR=wiki

# Directory inside the repo that holds raw immutable source dumps
RAW_SOURCES_DIR=raw_sources

# ── Server ──
HOST=0.0.0.0
PORT=8000
# ── Ngrok (Optional but recommended for public webhooks) ──
# Get yours at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=3CQRM7AWcUQyPH1xqg2u2EXSzIT_7XXn4wTcz2nTiQy18KyF5
